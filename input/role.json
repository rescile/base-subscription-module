{
  "version": "1.0",
  "provider": "aws",

  "compliance": {
    "frameworks": [
      "CSA-CCM",
      "ISO-27001",
      "SOC-2",
      "ISAE-3000",
      "ISAE-3402"
    ],

    "principles": [
      "least-privilege",
      "separation-of-duties",
      "privileged-access-management",
      "change-control",
      "auditability",
      "accountability",
      "continuous-monitoring"
    ]
  },

  "roles": {

    "cloud-compute-admin": {
      "display_name": "Compute Administrator",
      "category": "operations",
      "services": [
        "compute"
      ],
      "actions": {
        "allow": [
          "ec2:*",
          "autoscaling:*"
        ],
        "conditional": [
          "iam:PassRole"
        ]
      },
      "resources": [
        "ec2",
        "autoscaling"
      ],
      "controls": {
        "change-management": true,
        "logging": true,
        "least-privilege": true
      }
    },

    "cloud-storage-admin": {
      "display_name": "Storage Administrator",
      "category": "operations",
      "services": [
        "storage"
      ],
      "actions": {
        "allow": [
          "s3:*",
          "elasticfilesystem:*",
          "fsx:*"
        ],
        "conditional": [
          "kms:Decrypt",
          "kms:Encrypt",
          "kms:GenerateDataKey"
        ]
      },
      "resources": [
        "s3",
        "efs",
        "fsx"
      ],
      "controls": {
        "data-protection": true,
        "encryption": true,
        "change-management": true,
        "logging": true
      }
    },

    "cloud-network-admin": {
      "display_name": "Network Administrator",
      "category": "operations",
      "services": [
        "network"
      ],
      "actions": {
        "allow": [
          "ec2:CreateVpc*",
          "ec2:DeleteVpc*",
          "ec2:DescribeVpc*",
          "ec2:CreateSubnet*",
          "ec2:DeleteSubnet*",
          "ec2:ModifySubnet*",
          "ec2:CreateRoute*",
          "ec2:DeleteRoute*",
          "ec2:ReplaceRoute*",
          "ec2:CreateRouteTable*",
          "ec2:DeleteRouteTable*",
          "ec2:AssociateRouteTable",
          "ec2:DisassociateRouteTable",
          "ec2:CreateNatGateway",
          "ec2:DeleteNatGateway",
          "ec2:CreateNetworkInterface",
          "ec2:DeleteNetworkInterface",
          "ec2:ModifyNetworkInterfaceAttribute",
          "ec2:CreateTransitGateway*",
          "ec2:DeleteTransitGateway*",
          "ec2:ModifyTransitGateway*",
          "ec2:CreateTransitGatewayVpcAttachment",
          "ec2:DeleteTransitGatewayVpcAttachment"
        ],
        "conditional": [
          "iam:PassRole"
        ]
      },
      "resources": [
        "vpc",
        "subnet",
        "route-table",
        "nat-gateway",
        "transit-gateway",
        "network-interface"
      ],
      "controls": {
        "network-segmentation": true,
        "change-management": true,
        "logging": true,
        "least-privilege": true
      }
    },

    "cloud-database-admin": {
      "display_name": "Database Administrator",
      "category": "operations",
      "services": [
        "database"
      ],
      "actions": {
        "allow": [
          "rds:*",
          "dynamodb:*",
          "elasticache:*"
        ],
        "conditional": [
          "kms:Decrypt",
          "kms:Encrypt",
          "kms:GenerateDataKey"
        ]
      },
      "resources": [
        "rds",
        "aurora",
        "dynamodb",
        "elasticache"
      ],
      "controls": {
        "data-protection": true,
        "encryption": true,
        "backup": true,
        "change-management": true,
        "logging": true
      }
    },

    "cloud-container-admin": {
      "display_name": "Container Administrator",
      "category": "operations",
      "services": [
        "container"
      ],
      "actions": {
        "allow": [
          "ecr:*",
          "ecs:*"
        ],
        "conditional": [
          "iam:PassRole"
        ]
      },
      "resources": [
        "ecr",
        "ecs"
      ],
      "controls": {
        "image-security": true,
        "change-management": true,
        "logging": true
      }
    },

    "cloud-kubernetes-admin": {
      "display_name": "Kubernetes Administrator",
      "category": "operations",
      "services": [
        "kubernetes"
      ],
      "actions": {
        "allow": [
          "eks:*"
        ],
        "conditional": [
          "ec2:Describe*",
          "ec2:CreateNetworkInterface",
          "ec2:DeleteNetworkInterface",
          "iam:PassRole",
          "kms:DescribeKey",
          "kms:Encrypt",
          "kms:Decrypt"
        ]
      },
      "resources": [
        "eks",
        "eks-nodegroup",
        "eks-addon",
        "eks-fargate"
      ],
      "controls": {
        "cluster-security": true,
        "identity-management": true,
        "change-management": true,
        "logging": true
      }
    },

    "cloud-load-balancer-admin": {
      "display_name": "Load Balancer Administrator",
      "category": "operations",
      "services": [
        "load-balancer"
      ],
      "actions": {
        "allow": [
          "elasticloadbalancing:*"
        ],
        "conditional": [
          "ec2:Describe*",
          "acm:DescribeCertificate",
          "acm:ListCertificates"
        ]
      },
      "resources": [
        "alb",
        "nlb",
        "gwlb",
        "target-group",
        "listener"
      ],
      "controls": {
        "network-security": true,
        "tls": true,
        "change-management": true,
        "logging": true
      }
    },

    "cloud-dns-admin": {
      "display_name": "DNS Administrator",
      "category": "operations",
      "services": [
        "dns"
      ],
      "actions": {
        "allow": [
          "route53:*",
          "route53resolver:*"
        ]
      },
      "resources": [
        "hosted-zone",
        "record",
        "resolver-endpoint",
        "resolver-rule"
      ],
      "controls": {
        "network-security": true,
        "change-management": true,
        "logging": true
      }
    },

    "cloud-iam-admin": {
      "display_name": "Identity and Access Administrator",
      "category": "security",
      "services": [
        "iam"
      ],
      "actions": {
        "allow": [
          "iam:CreateRole",
          "iam:DeleteRole",
          "iam:GetRole",
          "iam:UpdateRole",
          "iam:AttachRolePolicy",
          "iam:DetachRolePolicy",
          "iam:PutRolePolicy",
          "iam:DeleteRolePolicy",
          "iam:CreatePolicy",
          "iam:DeletePolicy",
          "iam:CreatePolicyVersion",
          "iam:DeletePolicyVersion",
          "iam:SetDefaultPolicyVersion",
          "iam:List*",
          "iam:Get*"
        ],
        "deny": [
          "iam:CreateUser",
          "iam:DeleteUser",
          "iam:CreateAccessKey",
          "iam:DeleteAccessKey",
          "iam:UpdateAccountPasswordPolicy"
        ],
        "conditional": [
          "iam:PassRole"
        ]
      },
      "resources": [
        "role",
        "policy",
        "permissions-boundary",
        "identity-center"
      ],
      "controls": {
        "identity-management": true,
        "least-privilege": true,
        "separation-of-duties": true,
        "privileged-access-management": true,
        "access-review": true
      }
    },

    "cloud-security-admin": {
      "display_name": "Security Administrator",
      "category": "security",
      "services": [
        "firewall",
        "security"
      ],
      "actions": {
        "allow": [
          "network-firewall:*",
          "ec2:CreateSecurityGroup",
          "ec2:DeleteSecurityGroup",
          "ec2:AuthorizeSecurityGroupIngress",
          "ec2:AuthorizeSecurityGroupEgress",
          "ec2:RevokeSecurityGroupIngress",
          "ec2:RevokeSecurityGroupEgress",
          "ec2:ModifySecurityGroupRules",
          "guardduty:*",
          "securityhub:*"
        ]
      },
      "resources": [
        "network-firewall",
        "security-group",
        "guardduty",
        "security-hub"
      ],
      "controls": {
        "network-security": true,
        "threat-detection": true,
        "incident-response": true,
        "continuous-monitoring": true,
        "change-management": true
      }
    },

    "cloud-connectivity-admin": {
      "display_name": "Connectivity Administrator",
      "category": "network",
      "services": [
        "vpn",
        "private-connectivity"
      ],
      "actions": {
        "allow": [
          "ec2:CreateVpn*",
          "ec2:DeleteVpn*",
          "ec2:ModifyVpn*",
          "ec2:CreateCustomerGateway",
          "ec2:DeleteCustomerGateway",
          "ec2:CreateTransitGatewayConnect*",
          "ec2:DeleteTransitGatewayConnect*",
          "ec2:CreateTransitGatewayPeering*",
          "ec2:DeleteTransitGatewayPeering*",
          "ec2:CreateVpcEndpoint*",
          "ec2:DeleteVpcEndpoint*",
          "ec2:ModifyVpcEndpoint*",
          "ec2:CreateVpcEndpointService*",
          "ec2:DeleteVpcEndpointService*",
          "directconnect:*"
        ]
      },
      "resources": [
        "vpn",
        "customer-gateway",
        "transit-gateway-connect",
        "transit-gateway-peering",
        "vpc-endpoint",
        "privatelink",
        "direct-connect"
      ],
      "controls": {
        "network-security": true,
        "private-connectivity": true,
        "change-management": true,
        "logging": true
      }
    },

    "cloud-audit-admin": {
      "display_name": "Audit and Compliance Administrator",
      "category": "security",
      "services": [
        "audit",
        "compliance"
      ],
      "actions": {
        "allow": [
          "cloudtrail:Get*",
          "cloudtrail:List*",
          "cloudtrail:Describe*",
          "config:Get*",
          "config:List*",
          "config:Describe*",
          "access-analyzer:Get*",
          "access-analyzer:List*",
          "access-analyzer:ValidatePolicy",
          "securityhub:Get*",
          "securityhub:List*",
          "guardduty:Get*",
          "guardduty:List*"
        ],
        "deny": [
          "cloudtrail:StopLogging",
          "cloudtrail:DeleteTrail",
          "cloudtrail:UpdateTrail",
          "config:StopConfigurationRecorder",
          "config:DeleteConfigurationRecorder"
        ]
      },
      "resources": [
        "cloudtrail",
        "config",
        "access-analyzer",
        "security-hub",
        "guardduty"
      ],
      "controls": {
        "audit-trail": true,
        "continuous-monitoring": true,
        "evidence-collection": true,
        "independent-review": true,
        "tamper-resistance": true
      }
    },

    "cloud-platform-admin": {
      "display_name": "Cloud Platform Administrator",
      "category": "privileged",
      "services": [
        "all"
      ],
      "actions": {
        "allow": [
          "*"
        ]
      },
      "controls": {
        "break-glass": true,
        "emergency-access": true,
        "privileged-access-management": true,
        "mfa-required": true,
        "session-recording": true,
        "approval-required": true,
        "full-audit": true
      },
      "restrictions": {
        "normal-operation": false,
        "interactive-use": "break-glass-only",
        "persistent-assignment": false
      }
    }
  },

  "global_controls": {

    "authentication": {
      "federated-access-required": true,
      "mfa-required": true,
      "long-lived-access-keys": false,
      "root-user-operational-access": false
    },

    "privileged-access": {
      "jit-access": true,
      "approval-required": true,
      "maximum-session-duration": 3600,
      "session-recording": true,
      "cloudtrail-required": true
    },

    "segregation-of-duties": {
      "iam-admin-cannot-be-audit-admin": true,
      "security-admin-cannot-disable-audit": true,
      "audit-admin-read-only": true,
      "application-admin-cannot-administer-iam": true,
      "network-admin-cannot-administer-iam": true
    },

    "guardrails": {
      "scp": true,
      "permissions-boundaries": true,
      "resource-policies": true,
      "iam-access-analyzer": true
    },

    "audit": {
      "cloudtrail": {
        "enabled": true,
        "organization-trail": true,
        "centralized-storage": true,
        "log-integrity-validation": true
      },
      "configuration": {
        "aws-config": true
      },
      "access-analysis": {
        "iam-access-analyzer": true
      }
    }
  }
}
