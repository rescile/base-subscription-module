{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AWS Service Administrator Roles",
  "version": "1.0",
  "description": "Baseline service-specific administrator permission model for a multi-role AWS operating model.",
  "design_principles": [
    "One operational administrator role per logical service.",
    "No administrator role receives AWS Organizations or billing permissions by default.",
    "iam:PassRole should be granted separately and restricted to approved service-role ARNs.",
    "Resource tags, account boundaries, regions and permission boundaries should further constrain these permissions.",
    "Service administrators should not automatically administer KMS keys, CloudTrail, Config, GuardDuty or Security Hub unless explicitly assigned."
  ],
  "roles": {
    "compute-administrator": {
      "service": "compute",
      "resources": [
        "ec2",
        "autoscaling",
        "ec2-instance-connect",
        "imagebuilder"
      ],
      "permissions": [
        "ec2:Describe*",
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:CreateImage",
        "ec2:DeregisterImage",
        "ec2:CreateSnapshot",
        "ec2:DeleteSnapshot",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:AttachNetworkInterface",
        "ec2:DetachNetworkInterface",
        "autoscaling:*",
        "ec2-instance-connect:*",
        "imagebuilder:*"
      ],
      "notes": "Manage compute instances, images, autoscaling and instance connectivity. Restrict iam:PassRole separately to approved compute service roles."
    },
    "storage-administrator": {
      "service": "storage",
      "resources": [
        "s3",
        "ebs",
        "elasticfilesystem",
        "backup"
      ],
      "permissions": [
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetBucketEncryption",
        "s3:GetBucketPolicy",
        "s3:GetBucketTagging",
        "s3:PutBucketVersioning",
        "s3:PutBucketEncryption",
        "s3:PutBucketTagging",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "ec2:DescribeVolumes",
        "ec2:CreateVolume",
        "ec2:ModifyVolume",
        "ec2:DeleteVolume",
        "ec2:CreateSnapshot",
        "ec2:DeleteSnapshot",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "elasticfilesystem:*",
        "backup:*"
      ],
      "notes": "Full operational storage administration. Protect bucket policy changes and KMS administration with separate controls where required."
    },
    "network-administrator": {
      "service": "network",
      "resources": [
        "ec2",
        "elasticloadbalancing",
        "route53",
        "cloudwatch"
      ],
      "permissions": [
        "ec2:Describe*",
        "ec2:CreateVpc",
        "ec2:DeleteVpc",
        "ec2:ModifyVpcAttribute",
        "ec2:CreateSubnet",
        "ec2:DeleteSubnet",
        "ec2:ModifySubnetAttribute",
        "ec2:CreateRouteTable",
        "ec2:DeleteRouteTable",
        "ec2:CreateRoute",
        "ec2:ReplaceRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:CreateInternetGateway",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:DeleteInternetGateway",
        "ec2:CreateNatGateway",
        "ec2:DeleteNatGateway",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:CreateNetworkAcl",
        "ec2:DeleteNetworkAcl",
        "ec2:*NetworkAcl*",
        "ec2:CreateVpcEndpoint",
        "ec2:ModifyVpcEndpoint",
        "ec2:DeleteVpcEndpoints",
        "elasticloadbalancing:*",
        "route53:*"
      ],
      "notes": "Core VPC and L4/L7 network administration. Consider moving DNS, firewall, VPN and Direct Connect to their dedicated roles."
    },
    "database-administrator": {
      "service": "database",
      "resources": [
        "rds",
        "rds-data",
        "dynamodb",
        "elasticache"
      ],
      "permissions": [
        "rds:*",
        "rds-data:*",
        "dynamodb:*",
        "elasticache:*"
      ],
      "notes": "Operational administration of database services. Exclude IAM, KMS key administration and account-level controls."
    },
    "container-administrator": {
      "service": "container",
      "resources": [
        "ecs",
        "ecr"
      ],
      "permissions": [
        "ecs:*",
        "ecr:*"
      ],
      "notes": "ECS cluster/service/task and container registry administration. Restrict iam:PassRole to ECS task/execution roles."
    },
    "kubernetes-administrator": {
      "service": "kubernetes",
      "resources": [
        "eks",
        "eks-auth"
      ],
      "permissions": [
        "eks:*",
        "eks-auth:AssumeRoleForPodIdentity"
      ],
      "notes": "EKS control-plane and cluster administration. Kubernetes RBAC remains separate from AWS IAM permissions."
    },
    "loadbalancer-administrator": {
      "service": "load_balancer",
      "resources": [
        "elasticloadbalancing",
        "ec2"
      ],
      "permissions": [
        "elasticloadbalancing:*",
        "ec2:Describe*",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "notes": "Dedicated ELB administration with only the EC2 permissions normally needed for associated networking and security groups."
    },
    "dns-administrator": {
      "service": "dns",
      "resources": [
        "route53",
        "route53resolver"
      ],
      "permissions": [
        "route53:*",
        "route53resolver:*"
      ],
      "notes": "Route 53 public/private DNS and Resolver administration. DNSSEC/KMS operations should be separately governed if required."
    },
    "iam-administrator": {
      "service": "iam",
      "resources": [
        "iam",
        "sts"
      ],
      "permissions": [
        "iam:*",
        "sts:GetCallerIdentity"
      ],
      "notes": "Highly privileged role. In a regulated environment use JIT elevation, MFA, approval and strong CloudTrail monitoring. Do not grant Organizations or billing permissions by default."
    },
    "firewall-administrator": {
      "service": "firewall",
      "resources": [
        "network-firewall",
        "ec2"
      ],
      "permissions": [
        "network-firewall:*",
        "ec2:Describe*",
        "ec2:CreateVpcEndpoint",
        "ec2:ModifyVpcEndpoint",
        "ec2:DeleteVpcEndpoints"
      ],
      "notes": "AWS Network Firewall administration. Resource/tag conditions should normally restrict this role to designated firewall resources."
    },
    "vpn-administrator": {
      "service": "vpn",
      "resources": [
        "ec2"
      ],
      "permissions": [
        "ec2:Describe*",
        "ec2:CreateCustomerGateway",
        "ec2:DeleteCustomerGateway",
        "ec2:CreateVpnConnection",
        "ec2:DeleteVpnConnection",
        "ec2:ModifyVpnConnection",
        "ec2:CreateVpnGateway",
        "ec2:DeleteVpnGateway",
        "ec2:AttachVpnGateway",
        "ec2:DetachVpnGateway",
        "ec2:CreateVpnConnectionRoute",
        "ec2:DeleteVpnConnectionRoute",
        "ec2:CreateClientVpnEndpoint",
        "ec2:DeleteClientVpnEndpoint",
        "ec2:ModifyClientVpnEndpoint",
        "ec2:CreateClientVpnRoute",
        "ec2:DeleteClientVpnRoute",
        "ec2:AuthorizeClientVpnIngress",
        "ec2:RevokeClientVpnIngress",
        "ec2:AssociateClientVpnTargetNetwork",
        "ec2:DisassociateClientVpnTargetNetwork",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "notes": "Site-to-site and Client VPN operations. Certificates, private CA and IAM identity administration remain outside this role."
    },
    "connectivity-administrator": {
      "service": "connectivity",
      "resources": [
        "directconnect",
        "ec2"
      ],
      "permissions": [
        "directconnect:*",
        "ec2:Describe*",
        "ec2:CreateTransitGateway",
        "ec2:DeleteTransitGateway",
        "ec2:ModifyTransitGateway",
        "ec2:CreateTransitGatewayRouteTable",
        "ec2:DeleteTransitGatewayRouteTable",
        "ec2:CreateTransitGatewayRoute",
        "ec2:ReplaceTransitGatewayRoute",
        "ec2:DeleteTransitGatewayRoute",
        "ec2:AssociateTransitGatewayRouteTable",
        "ec2:DisassociateTransitGatewayRouteTable",
        "ec2:CreateTransitGatewayVpcAttachment",
        "ec2:DeleteTransitGatewayVpcAttachment",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "notes": "Direct Connect and Transit Gateway connectivity. Provider/partner-side provisioning is outside AWS IAM."
    }
  }
}
